{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@rashwright/ui-mobile": [
        "../ui-mobile/index.ts"
      ],
      "@rashwright/ui-mobile/*": [
        "../ui-mobile/*"
      ],
      "@/*": [
        "./*"
      ]
    },
    "jsx": "react-native"
  },
  "include": [
    "src/**/*.ts"
  ]
}
