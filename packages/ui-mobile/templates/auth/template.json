{
  "id": "auth",
  "name": "Authentication Suite",
  "type": "registry:block",
  "version": "1.0.1",
  "registryVersion": "1.6.1",
  "description": "Suite complète d'authentification : écrans séparés SignIn et SignUp, bouton Google Auth et validation OTP sécurisée.",
  "componentName": "AuthTemplate",
  "entrypoint": "auth-template.tsx",
  "files": [
    "auth-template.tsx",
    "sign-in.tsx",
    "sign-up.tsx",
    "types.ts",
    "components/login-form.tsx",
    "components/register-form.tsx",
    "components/otp-step.tsx",
    "components/google-auth-button.tsx",
    "index.ts"
  ],
  "requiredComponents": [
    "badge",
    "button",
    "card",
    "checkbox",
    "otp-input",
    "rashwright-logo",
    "text-input"
  ],
  "requiresFoundations": [
    "theme"
  ],
  "dependencies": [],
  "expoDependencies": [
    "react-native-safe-area-context"
  ],
  "supportsGlass": true,
  "screens": [
    {
      "route": "sign-in",
      "file": "sign-in.tsx",
      "componentName": "SignInScreen",
      "title": "Connexion"
    },
    {
      "route": "sign-up",
      "file": "sign-up.tsx",
      "componentName": "SignUpScreen",
      "title": "Inscription"
    }
  ]
}
