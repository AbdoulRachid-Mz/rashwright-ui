{
  "name": "@rashwright/ui-mobile",
  "version": "0.1.2",
  "description": "Rashwright UI Mobile — Composants React Native / Expo distribuables",
  "license": "MIT",
  "author": "Rashwright office",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdoulRachid-Mz/rashwright-ui.git"
  },
  "keywords": ["react-native", "expo", "ui", "components", "shadcn", "liquid-glass", "registry"],
  "type": "module",
  "sideEffects": false,
  "files": [
    "components/**",
    "constants/**",
    "contexts/**",
    "hooks/**",
    "stores/**",
    "theme/**",
    "types/**",
    "assets/**",
    "registry/**",
    "skills/**",
    "lib/**",
    "index.ts",
    "README.md"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "tsc": "tsc --noEmit",
    "version:current": "node -e \"const p=JSON.parse(require('node:fs').readFileSync('./package.json','utf8'));console.log(p.name + '@' + p.version)\"",
    "lint:any": "node ../../scripts/ui-lint-any.mjs",
    "lint:ambient-zero-any": "node ../../scripts/ui-lint-ambient-zero-any.mjs",
    "list:components": "node ../../scripts/ui-list-components.mjs",
    "count:tsx": "node ../../scripts/ui-count-tsx.mjs",
    "publish:dry-run": "npm publish --dry-run --access public",
    "publish:npm": "echo \"ATTENTION: lancer 'npm publish --access public' (avec --otp=XXXXXX si 2FA) depuis packages/ui-mobile/\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "expo": ">=54.0.0",
    "react": ">=18.3.0",
    "react-native": ">=0.73.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "zustand": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": { "optional": true },
    "react-native-safe-area-context": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-native": "^0.73.0",
    "expo": "^54.0.0",
    "react": "18.3.1",
    "react-native": "0.74.5",
    "react-native-reanimated": "^3.16.0",
    "react-native-safe-area-context": "^4.14.0",
    "typescript": "^5.5.0",
    "zustand": "^5.0.0"
  }
}
