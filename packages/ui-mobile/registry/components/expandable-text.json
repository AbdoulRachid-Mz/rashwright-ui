{
  "name": "expandable-text",
  "version": "1.0.0",
  "description": "Composant de texte tronqué avec bouton interactif Voir plus / Voir moins, animation fluide et support d'accessibilité.",
  "category": "Basic",
  "files": [
    "components/ui/expandable-text.tsx"
  ],
  "dependencies": [],
  "expoDependencies": [],
  "optionalExpoDependencies": [],
  "requiresComponents": [],
  "providers": [
    "ThemeProvider"
  ],
  "supportsGlass": false,
  "platforms": [
    "ios",
    "android",
    "web"
  ],
  "nativeRebuildRequired": false,
  "props": {
    "children": "string",
    "maxLines": "number",
    "expandText": "string",
    "collapseText": "string",
    "variant": [
      "xs",
      "sm",
      "base",
      "lg",
      "xl"
    ],
    "color": "string",
    "actionColor": "string",
    "allowCollapse": "boolean",
    "defaultExpanded": "boolean",
    "onExpandChange": "function"
  }
}
