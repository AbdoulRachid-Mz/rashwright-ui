{
  "name": "button",
  "type": "registry:ui",
  "version": "1.0.0",
  "registryVersion": "1.6.3",
  "description": "Bouton interactif universel pour React Native avec variants, tailles, états et support Glass.",
  "category": "Basic",
  "files": [
    "components/ui/button.tsx"
  ],
  "dependencies": [],
  "expoDependencies": [
    "expo-blur",
    "expo-linear-gradient",
    "react-native-reanimated"
  ],
  "optionalExpoDependencies": [
    "expo-haptics"
  ],
  "requiresComponents": [
    "text"
  ],
  "requiresFoundations": [
    "core-ui",
    "glass",
    "liquid",
    "theme"
  ],
  "providers": [
    "ThemeProvider"
  ],
  "supportsGlass": true,
  "platforms": [
    "ios",
    "android"
  ],
  "nativeRebuildRequired": false,
  "props": {
    "variant": [
      "primary",
      "secondary",
      "outline",
      "ghost",
      "destructive",
      "glass"
    ],
    "size": [
      "sm",
      "md",
      "lg"
    ],
    "disabled": "boolean",
    "loading": "boolean",
    "onPress": "function"
  }
}
