{
  "name": "@rashwright/workspace-root",
  "private": true,
  "version": "0.3.0",
  "description": "Rashwright UI Mobile — Workspace racine (Bun workspaces)",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": ["packages/*"],
  "scripts": {
    "check-types": "bun run check-types:cli && bun run check-types:ui",
    "check-types:cli": "bun run --filter @rashwright/cli check-types",
    "check-types:ui": "bun run --filter @rashwright/ui-mobile check-types",
    "tsc": "bun run check-types",
    "tsc:root": "npx tsc --noEmit",
    "sync-registry": "bun run scripts/sync-registry.ts",
    "validate-registry": "bun run scripts/validate-registry.ts",
    "registry:sync": "bun run sync-registry",
    "registry:validate": "bun run validate-registry",
    "build:cli": "bun run --filter @rashwright/cli build",
    "dev:cli": "bun run --filter @rashwright/cli dev",
    "cli": "bun run packages/cli/src/index.ts",
    "cli:help": "bun run cli --help",
    "cli:version": "bun run cli --version",
    "cli:list": "bun run cli list",
    "cli:list:json": "bun run cli list --json",
    "cli:info": "bun run cli info",
    "cli:doctor": "bun run cli doctor",
    "test": "bun --filter @rashwright/cli test",
    "test:cli": "bun --filter @rashwright/cli test",
    "test:coverage": "bun --filter @rashwright/cli test:coverage",
    "quality": "bun run validate-registry && bun run check-types && bun run test && bun run build:cli && bun run --filter @rashwright/cli smoke:all",
    "preflight": "bun run quality",
    "dry-run:ui": "bun run --filter @rashwright/ui-mobile publish:dry-run",
    "dry-run:cli": "bun run --filter @rashwright/cli publish:dry-run",
    "dry-run": "bun run dry-run:ui && bun run dry-run:cli",
    "lint:ui-any": "bun run --filter @rashwright/ui-mobile lint:any",
    "lint:cli-require": "bun run --filter @rashwright/cli lint:require",
    "clean:cli": "bun run --filter @rashwright/cli clean",
    "clean": "bun run clean:cli"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@types/node": "^22.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^12.5.0",
    "ora": "^8.1.1",
    "typescript": "^5.5.0"
  }
}
